<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Proyecto.Registrarse"
             Title="Registrarse">
    <ScrollView>
        <VerticalStackLayout Padding="30,60,30,30" 
                             Spacing="25" 
                             VerticalOptions="Center">

            <!-- Icono / Avatar superior -->
            <Frame WidthRequest="160" 
                   HeightRequest="141" 
                   CornerRadius="16" 
                   BackgroundColor="Transparent" 
                   BorderColor="Transparent"
                   HorizontalOptions="Center"
                   Padding="0">
                <Image Source="logo.png" 
                       WidthRequest="160" 
                       HeightRequest="160" 
                       HorizontalOptions="Start" 
                       VerticalOptions="Start" />
            </Frame>

            <!-- Títulos -->
            <VerticalStackLayout Spacing="5" HorizontalOptions="Center">

                <Label Text="Bienvenido" 
                       FontSize="22" 
                       FontAttributes="Bold" 
                       TextColor="White" 
                       HorizontalTextAlignment="Center" />
                <Label Text="Registre sus datos para continuar" 
                       FontSize="14" 
                       TextColor="#8E8E93" 
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- Formulario de Entrada -->
            <VerticalStackLayout Spacing="15" Margin="0,10,0,0">
                
                <!-- Correo Electrónico -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Nombre" 
            FontSize="12" 
            TextColor="#8E8E93" />
                    <Frame BackgroundColor="#1E1E1E" 
            BorderColor="#2C2C2C" 
            CornerRadius="12" 
            Padding="14,5" 
            HasShadow="False">
                        <Entry x:Name="TxtNombre"
                Placeholder="Juan Pérez" 
                PlaceholderColor="#555555"
                TextColor="White" 
                FontSize="14" />
                    </Frame>
                </VerticalStackLayout>

                <!-- Correo Electrónico -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Correo electrónico" 
                           FontSize="12" 
                           TextColor="#8E8E93" />
                    <Frame BackgroundColor="#1E1E1E" 
                           BorderColor="#2C2C2C" 
                           CornerRadius="12" 
                           Padding="14,5" 
                           HasShadow="False">
                        <Entry x:Name="TxtCorreo"
                               Placeholder="correo@ejemplo.com" 
                               PlaceholderColor="#555555"
                               TextColor="White" 
                               FontSize="14"
                               Keyboard="Email" />
                    </Frame>
                </VerticalStackLayout>

                <!-- Contraseña -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="Contraseña" 
                           FontSize="12" 
                           TextColor="#8E8E93" />
                    <Frame BackgroundColor="#1E1E1E" 
                           BorderColor="#2C2C2C" 
                           CornerRadius="12" 
                           Padding="12,5" 
                           HasShadow="False">
                        <Grid ColumnDefinitions="*, Auto">
                            <Entry x:Name="TxtContrasena"
                                   Grid.Column="0"
                                   Placeholder="••••••••••••" 
                                   PlaceholderColor="#555555"
                                   TextColor="White" 
                                   FontSize="14"
                                   IsPassword="True" />
                            <!-- Botón o icono opcional para mostrar/ocultar contraseña -->
                            <ImageButton x:Name="BtnTogglePassword"
                                         Grid.Column="1"
                                         Source="eye_icon.png"
                                         WidthRequest="20"
                                         HeightRequest="20"
                                         BackgroundColor="Transparent"
                                         Clicked="OnTogglePasswordClicked" />
                        </Grid>
                    </Frame>
                </VerticalStackLayout>

                <!-- Opciones adicionales (Recordarme / Olvidaste contraseña) -->
                <Grid ColumnDefinitions="Auto, *" Margin="0,5">
                    <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                        <CheckBox x:Name="ChkRecordarme" Color="White" />
                        <Label Text="Ver contraseña" 
                               TextColor="#8E8E93" 
                               FontSize="13" 
                               VerticalOptions="Center" />
                    </HorizontalStackLayout>

                   
                </Grid>

            </VerticalStackLayout>

            <!-- Botón Iniciar Sesión -->
            <Button Text="Registrarse" 
                    BackgroundColor="White" 
                    TextColor="Black" 
                    FontAttributes="Bold"
                    CornerRadius="14"
                    HeightRequest="50"
                    FontSize="15"
                    Clicked="OnLoginClicked" />

            <!-- Enlace de Registro -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="5" Margin="0,10,0,0">
                <Label Text="¿Ya posees una cuenta?" 
                       TextColor="#8E8E93" 
                       FontSize="13" />
                <Label Text="Inicia sesión" 
                       TextColor="White" 
                       FontAttributes="Bold" 
                       FontSize="13"
                       TextDecorations="Underline">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRegisterTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>