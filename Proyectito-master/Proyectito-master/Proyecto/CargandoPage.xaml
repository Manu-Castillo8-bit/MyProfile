<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Proyecto.CargandoPage"
             BackgroundColor="#0B1120"
             Shell.NavBarIsVisible="False"
             Shell.TabBarIsVisible="False">

    <Grid RowDefinitions="*, Auto" Padding="28,40,28,40">

        <VerticalStackLayout Grid.Row="0"
                             VerticalOptions="Center"
                             HorizontalOptions="Center"
                             Spacing="16">

            <Frame WidthRequest="120"
                   HeightRequest="120"
                   CornerRadius="20"
                   BackgroundColor="Transparent"
                   BorderColor="Transparent"
                   Padding="0"
                   HorizontalOptions="Center">
                <Image Source="img_logo.png"
                       WidthRequest="120"
                       HeightRequest="120" />
            </Frame>

            <Label Text="MyProfile"
                   FontSize="30"
                   FontAttributes="Bold"
                   TextColor="White"
                   HorizontalTextAlignment="Center" />

            <Label Text="Preparando tu experiencia..."
                   FontSize="14"
                   TextColor="#8E8E93"
                   HorizontalTextAlignment="Center" />

            <ProgressBar x:Name="ProgCarga"
                         Progress="0"
                         ProgressColor="#2563EB"
                         BackgroundColor="#1E1E1E"
                         WidthRequest="260"
                         HeightRequest="8"
                         Margin="0,10,0,0" />

            <Label x:Name="LblPorcentaje"
                   Text="0%"
                   FontSize="13"
                   TextColor="#8E8E93"
                   HorizontalTextAlignment="Center" />
        </VerticalStackLayout>

        <Frame Grid.Row="1"
               BackgroundColor="#111C30"
               BorderColor="#245B78"
               CornerRadius="12"
               Padding="16"
               HasShadow="False">
            <VerticalStackLayout Spacing="4">
                <Label Text="¿Sabías que...?"
                       FontSize="12"
                       FontAttributes="Bold"
                       TextColor="#ffffff" />
                <Label x:Name="LblConsejo"
                       Text=""
                       FontSize="13"
                       TextColor="#ffffff" />
            </VerticalStackLayout>
        </Frame>
    </Grid>

</ContentPage>
