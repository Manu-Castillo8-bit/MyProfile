<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Proyecto.LoginPage"
             BackgroundColor="#0b1120"
             Title="LoginPage">
    <ScrollView>
        <VerticalStackLayout Padding="30,60,30,30" 
                             Spacing="25" 
                             VerticalOptions="Center">

            <!-- Icono / Avatar superior -->
            <Frame WidthRequest="160" 
                   HeightRequest="141" 
                   CornerRadius="16" 
                   BackgroundColor="Transparent" 
                   BorderColor="Transparent"
                   HorizontalOptions="Center"
                   Padding="0">
                <Image Source="logo.png" 
                       WidthRequest="160" 
                       HeightRequest="160" 
                       HorizontalOptions="Start" 
                       VerticalOptions="Start" />
            </Frame>

            <!-- Títulos -->
            <VerticalStackLayout Spacing="5" HorizontalOptions="Center">
               
                <Label Text="Bienvenido" 
                       FontSize="22" 
                       FontAttributes="Bold" 
                       TextColor="White" 
                       HorizontalTextAlignment="Center" />
                <Label Text="Inicia sesión para continuar" 
                       FontSize="14" 
                       TextColor="gray" 
                       HorizontalTextAlignment="Center" />
            </VerticalStackLayout>

            <!-- Formulario de Entrada -->
            <VerticalStackLayout Spacing="15" Margin="0,10,0,0">

                <!-- Correo Electrónico -->
                <VerticalStackLayout Spacing="6">
                    <Label Text="Correo electrónico" 
                           FontSize="12" 
                           FontAttributes="Bold"
                           TextColor="#ffffff" />
                    <Frame BackgroundColor="#111c30" 
                           BorderColor="#245b78" 
                           CornerRadius="12" 
                           Padding="14,5" 
                           HasShadow="False">
                        <Entry x:Name="TxtCorreo"
                               Placeholder="correo@ejemplo.com" 
                               PlaceholderColor="#64748b"
                               TextColor="White" 
                               FontSize="14"
                               Keyboard="Email" />
                    </Frame>
                </VerticalStackLayout>

                <!-- Contraseña -->
                <VerticalStackLayout Spacing="5">
                    <Label Text="Contraseña" 
                           FontSize="12" 
                           FontAttributes="Bold"
                           TextColor="#ffffff" />
                    <Frame BackgroundColor="#111c30" 
                           BorderColor="#245b78" 
                           CornerRadius="12" 
                           Padding="12,5" 
                           HasShadow="False">
                        <Grid ColumnDefinitions="*, Auto">
                            <Entry x:Name="TxtContrasena"
                                   Grid.Column="0"
                                   Placeholder="••••••••••••" 
                                   PlaceholderColor="#64748b"
                                   TextColor="White" 
                                   FontSize="14"
                                   IsPassword="True" />
                            <!-- Botón o icono opcional para mostrar/ocultar contraseña -->
                            <ImageButton x:Name="BtnTogglePassword"
                                         Grid.Column="1"
                                         Source="ver_contra.png"
                                         WidthRequest="10"
                                         HeightRequest="10"
                                         BackgroundColor="Transparent"
                                         Clicked="OnTogglePasswordClicked" />
                        </Grid>
                    </Frame>
                </VerticalStackLayout>

                <!-- Opciones adicionales (Recordarme / Olvidaste contraseña) -->
                <Grid ColumnDefinitions="Auto, *" Margin="0,5">
                    <HorizontalStackLayout Grid.Column="0" Spacing="8" VerticalOptions="Center">
                    <!--    <CheckBox x:Name="ChkRecordarme" Color="White" />
                        <Label Text="Ver contraseña" 
                               TextColor="#8E8E93" 
                               FontSize="13" 
                               VerticalOptions="Center" />-->
                    </HorizontalStackLayout>
                    
        <!--       <Label Grid.Column="1" 
                           Text="¿Olvidaste tu contraseña?" 
                           TextColor="#8E8E93" 
                           FontSize="13" 
                           HorizontalTextAlignment="End" 
                           VerticalOptions="Center">
                        <Label.GestureRecognizers>
                            <TapGestureRecognizer Tapped="OnForgotPasswordTapped" />
                        </Label.GestureRecognizers>
                    </Label> -->
                </Grid>

            </VerticalStackLayout>

            <!-- Botón Iniciar Sesión -->
            <Grid HeightRequest="50">
                <Button Text="Iniciar Sesión" 
                        BackgroundColor="#2563EB" 
                        TextColor="White" 
                        FontAttributes="Bold"
                        CornerRadius="14"
                        HeightRequest="50"
                        FontSize="15"
                        Clicked="OnLoginClicked" />
                <ActivityIndicator x:Name="IndicadorLogin"
                                   IsVisible="False"
                                   IsRunning="False"
                                   Color="#121212"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />
            </Grid>

            <!-- Enlace de Registro -->
            <HorizontalStackLayout HorizontalOptions="Center" Spacing="5" Margin="0,10,0,0">
                <Label Text="¿No tienes cuenta?" 
                       TextColor="gray" 
                       FontSize="13" />
                <Label Text="Regístrate" 
                       TextColor="White" 
                       FontAttributes="Bold" 
                       FontSize="13"
                       TextDecorations="Underline">
                    <Label.GestureRecognizers>
                        <TapGestureRecognizer Tapped="OnRegisterTapped" />
                    </Label.GestureRecognizers>
                </Label>
            </HorizontalStackLayout>

        </VerticalStackLayout>
    </ScrollView>
</ContentPage>