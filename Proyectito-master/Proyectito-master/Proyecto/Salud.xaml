<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Proyecto.Salud"
             Title="Salud"

  
             BackgroundColor="#121212"
             Shell.NavBarIsVisible="False">

        <ScrollView>
            <VerticalStackLayout Padding="20,40,20,30" Spacing="20">

                <Label Text="Salud y Bienestar" FontSize="22" FontAttributes="Bold" TextColor="White" />

                <!-- Sección Hidratación -->
                <Frame BackgroundColor="#1E1E1E" BorderColor="#2C2C2C" CornerRadius="16" Padding="16" HasShadow="False">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="💧 Hidratación" TextColor="White" FontSize="16" FontAttributes="Bold" />

                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="Recordatorio de beber agua" TextColor="#8E8E93" FontSize="14" VerticalOptions="Center" />
                            <Switch x:Name="SwAgua" Grid.Column="1" IsToggled="False" OnColor="Black" Toggled="OnRecordatorioToggled" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                            <Label Text="Frecuencia (min)" TextColor="#8E8E93" FontSize="13" VerticalOptions="Center" />
                            <Entry x:Name="TxtFrecAgua"
                                   Keyboard="Numeric"
                                   Placeholder="45"
                                   TextColor="White"
                                   PlaceholderColor="#555"
                                   BackgroundColor="#2C2C2C"
                                   HeightRequest="42"
                                   FontSize="14" />
                        </Grid>

                        <Button Text="Guardar preferencias"
                                BackgroundColor="White"
                                TextColor="Black"
                                FontAttributes="Bold"
                                CornerRadius="12"
                                HeightRequest="42"
                                Clicked="OnGuardarAguaClicked" />

                        <BoxView HeightRequest="1" BackgroundColor="#2C2C2C" />

                        <!-- Conteo local de vasos del día (solo en el dispositivo) -->
                        <Grid ColumnDefinitions="Auto, *" Margin="0,2,0,0">
                            <Frame Grid.Column="0" BackgroundColor="#2C2C2C" WidthRequest="60" HeightRequest="60" CornerRadius="10" Padding="0" HasShadow="False">
                                <Label Text="🚰" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Frame>
                            <VerticalStackLayout Grid.Column="1" Margin="15,0,0,0" Spacing="4" VerticalOptions="Center">
                                <Label x:Name="LblVasos" Text="Vasos hoy: 0 / 8" TextColor="White" FontSize="15" FontAttributes="Bold" />
                                <ProgressBar x:Name="ProgAgua" Progress="0.0" ProgressColor="White" BackgroundColor="#2C2C2C" HeightRequest="6" />
                                <Label x:Name="LblPorcentajeAgua" Text="0% de la meta diaria" TextColor="#8E8E93" FontSize="11" />
                            </VerticalStackLayout>
                        </Grid>

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                            <Button Grid.Column="0" Text="+ Registrar vaso" BackgroundColor="#1E1E1E" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="40" BorderColor="#2C2C2C" Clicked="OnMasVasoClicked" />
                            <Button Grid.Column="1" Text="− Quitar vaso" BackgroundColor="#1E1E1E" TextColor="#FF3B30" FontAttributes="Bold" CornerRadius="12" HeightRequest="40" BorderColor="#2C2C2C" Clicked="OnMenosVasoClicked" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

                <!-- Sección Descanso Visual -->
                <Frame BackgroundColor="#1E1E1E" BorderColor="#2C2C2C" CornerRadius="16" Padding="16" HasShadow="False">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="👁️ Descanso Visual" TextColor="White" FontSize="16" FontAttributes="Bold" />

                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="Recordatorio de descanso visual" TextColor="#8E8E93" FontSize="14" VerticalOptions="Center" />
                            <Switch x:Name="SwDescanso" Grid.Column="1" IsToggled="True" OnColor="Black" Toggled="OnRecordatorioToggled" />
                        </Grid>

                        <Grid ColumnDefinitions="Auto, *" ColumnSpacing="10">
                            <Label Text="Frecuencia (min)" TextColor="#8E8E93" FontSize="13" VerticalOptions="Center" />
                            <Entry x:Name="TxtFrecDescanso"
                                   Keyboard="Numeric"
                                   Placeholder="20"
                                   TextColor="White"
                                   PlaceholderColor="#555"
                                   BackgroundColor="#2C2C2C"
                                   HeightRequest="42"
                                   FontSize="14" />
                        </Grid>

                        <Label x:Name="LblProximo" Text="Activa el recordatorio para ver el próximo descanso" TextColor="White" FontSize="13" FontAttributes="Bold" />

                        <Button Text="Guardar preferencias"
                                BackgroundColor="White"
                                TextColor="Black"
                                FontAttributes="Bold"
                                CornerRadius="12"
                                HeightRequest="42"
                                Clicked="OnGuardarDescansoClicked" />

                        <BoxView HeightRequest="1" BackgroundColor="#2C2C2C" />

                        <!-- Conteo local de descansos del día (solo en el dispositivo) -->
                        <Label x:Name="LblDescansos" Text="Descansos registrados hoy: 0" TextColor="White" FontSize="14" FontAttributes="Bold" />

                        <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                            <Button Grid.Column="0" Text="✓ Registrar descanso" BackgroundColor="#1E1E1E" TextColor="White" FontAttributes="Bold" CornerRadius="12" HeightRequest="40" BorderColor="#2C2C2C" Clicked="OnMasDescansoClicked" />
                            <Button Grid.Column="1" Text="− Quitar descanso" BackgroundColor="#1E1E1E" TextColor="#FF3B30" FontAttributes="Bold" CornerRadius="12" HeightRequest="40" BorderColor="#2C2C2C" Clicked="OnMenosDescansoClicked" />
                        </Grid>
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>
    
</ContentPage>