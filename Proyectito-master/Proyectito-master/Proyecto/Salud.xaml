<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Proyecto.Salud"
             Title="Salud"
             BackgroundColor="#0B1120"
             Shell.NavBarIsVisible="False">

    <ScrollView>
        <VerticalStackLayout Padding="20,40,20,30" Spacing="16">

            <!-- Encabezado -->
            <VerticalStackLayout Spacing="4">
                <Label Text="Salud y Bienestar" FontSize="24" FontAttributes="Bold" TextColor="White" />
                <Label Text="Organiza tu hidratación y descanso diario" FontSize="13" TextColor="#8E8E93" />
            </VerticalStackLayout>

            <!-- ─── Hidratación ─── -->
            <Frame BackgroundColor="#1E1E1E" BorderColor="#2C2C2C" CornerRadius="16" Padding="16" HasShadow="False">
                <VerticalStackLayout Spacing="16">

                    <!-- Cabecera de la tarjeta -->
                    <Grid ColumnDefinitions="Auto, *" VerticalOptions="Center">
                        <Frame Grid.Column="0" BackgroundColor="#2C2C2C" WidthRequest="40" HeightRequest="40" CornerRadius="12" Padding="0" HasShadow="False">
                            <Label Text="💧" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Frame>
                        <VerticalStackLayout Grid.Column="1" Margin="12,0,0,0" Spacing="2" VerticalOptions="Center">
                            <Label Text="Hidratación" TextColor="White" FontSize="17" FontAttributes="Bold" />
                            <Label Text="Meta diaria: 8 vasos" TextColor="#8E8E93" FontSize="12" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Recordatorio -->
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Recordatorio de beber agua" TextColor="White" FontSize="14" />
                            <Label Text="Te avisará durante el día" TextColor="#8E8E93" FontSize="12" />
                        </VerticalStackLayout>
                        <Switch x:Name="SwAgua" Grid.Column="1" IsToggled="False" OnColor="Black" Toggled="OnRecordatorioToggled" />
                    </Grid>

                    <!-- Frecuencia + Guardar -->
                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                        <Label Grid.Column="0" Text="Frecuencia (min)" TextColor="#8E8E93" FontSize="13" VerticalOptions="Center" />
                        <Entry x:Name="TxtFrecAgua" Grid.Column="1"
                               Keyboard="Numeric"
                               Placeholder="45"
                               TextColor="White"
                               PlaceholderColor="#555"
                               BackgroundColor="#2C2C2C"
                               HeightRequest="42"
                               FontSize="14"
                               HorizontalOptions="Fill" />
                        <Button Grid.Column="2" Text="Guardar"
                                BackgroundColor="White"
                                TextColor="Black"
                                BorderColor="#3A3A3A"
                                BorderWidth="1"
                                FontAttributes="Bold"
                                FontSize="13"
                                CornerRadius="10"
                                Padding="16,0"
                                HeightRequest="42"
                                VerticalOptions="Center"
                                Clicked="OnGuardarAguaClicked" />
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="#2C2C2C" />

                    <!-- Progreso del día -->
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                        <Frame Grid.Column="0" BackgroundColor="#2C2C2C" WidthRequest="52" HeightRequest="52" CornerRadius="26" Padding="0" HasShadow="False">
                            <Label Text="🚰" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Frame>
                        <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                            <Grid ColumnDefinitions="*, Auto">
                                <Label x:Name="LblVasos" Grid.Column="0" Text="Vasos hoy: 0 / 8" TextColor="White" FontSize="14" FontAttributes="Bold" VerticalOptions="Center" />
                                <Label x:Name="LblPorcentajeAgua" Grid.Column="1" Text="0% de la meta diaria" TextColor="#8E8E93" FontSize="11" VerticalOptions="Center" />
                            </Grid>
                            <ProgressBar x:Name="ProgAgua" Progress="0.0" ProgressColor="White" BackgroundColor="#2C2C2C" HeightRequest="6" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                        <Button Grid.Column="0" Text="+  Registrar vaso" BackgroundColor="White" TextColor="Black" FontAttributes="Bold" FontSize="13" CornerRadius="10" HeightRequest="42" BorderColor="#2C2C2C" Clicked="OnMasVasoClicked" />
                        <Button Grid.Column="1" Text="−  Quitar vaso" BackgroundColor="#1E1E1E" TextColor="#FF3B30" FontAttributes="Bold" FontSize="13" CornerRadius="10" HeightRequest="42" BorderColor="#2C2C2C" Clicked="OnMenosVasoClicked" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- ─── Descanso Visual ─── -->
            <Frame BackgroundColor="#1E1E1E" BorderColor="#2C2C2C" CornerRadius="16" Padding="16" HasShadow="False">
                <VerticalStackLayout Spacing="16">

                    <!-- Cabecera de la tarjeta -->
                    <Grid ColumnDefinitions="Auto, *" VerticalOptions="Center">
                        <Frame Grid.Column="0" BackgroundColor="#2C2C2C" WidthRequest="40" HeightRequest="40" CornerRadius="12" Padding="0" HasShadow="False">
                            <Label Text="👁️" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Frame>
                        <VerticalStackLayout Grid.Column="1" Margin="12,0,0,0" Spacing="2" VerticalOptions="Center">
                            <Label Text="Descanso Visual" TextColor="White" FontSize="17" FontAttributes="Bold" />
                            <Label Text="Cuidado de la vista" TextColor="#8E8E93" FontSize="12" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Recordatorio -->
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Recordatorio de descanso visual" TextColor="White" FontSize="14" />
                            <Label Text="Te avisará para mirar a lo lejos" TextColor="#8E8E93" FontSize="12" />
                        </VerticalStackLayout>
                        <Switch x:Name="SwDescanso" Grid.Column="1" IsToggled="True" OnColor="Black" Toggled="OnRecordatorioToggled" />
                    </Grid>

                    <!-- Frecuencia + Guardar -->
                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                        <Label Grid.Column="0" Text="Frecuencia (min)" TextColor="#8E8E93" FontSize="13" VerticalOptions="Center" />
                        <Entry x:Name="TxtFrecDescanso" Grid.Column="1"
                               Keyboard="Numeric"
                               Placeholder="20"
                               TextColor="White"
                               PlaceholderColor="#555"
                               BackgroundColor="#2C2C2C"
                               HeightRequest="42"
                               FontSize="14"
                               HorizontalOptions="Fill" />
                        <Button Grid.Column="2" Text="Guardar"
                                BackgroundColor="White"
                                TextColor="Black"
                                BorderColor="#3A3A3A"
                                BorderWidth="1"
                                FontAttributes="Bold"
                                FontSize="13"
                                CornerRadius="10"
                                Padding="16,0"
                                HeightRequest="42"
                                VerticalOptions="Center"
                                Clicked="OnGuardarDescansoClicked" />
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="#2C2C2C" />

                    <!-- Estado del día -->
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                        <Frame Grid.Column="0" BackgroundColor="#2C2C2C" WidthRequest="52" HeightRequest="52" CornerRadius="26" Padding="0" HasShadow="False">
                            <Label Text="👁️" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Frame>
                        <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                            <Label x:Name="LblProximo" Text="Activa el recordatorio para ver el próximo descanso" TextColor="White" FontSize="14" FontAttributes="Bold" />
                            <Label x:Name="LblDescansos" Text="Descansos registrados hoy: 0" TextColor="#8E8E93" FontSize="12" />
                        </VerticalStackLayout>
                    </Grid>

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10">
                        <Button Grid.Column="0" Text="✓  Registrar descanso" BackgroundColor="white" TextColor="Black" FontAttributes="Bold" FontSize="13" CornerRadius="10" HeightRequest="42" BorderColor="#2C2C2C" Clicked="OnMasDescansoClicked" />
                        <Button Grid.Column="1" Text="−  Quitar descanso" BackgroundColor="#1E1E1E" TextColor="#FF3B30" FontAttributes="Bold" FontSize="13" CornerRadius="10" HeightRequest="42" BorderColor="#2C2C2C" Clicked="OnMenosDescansoClicked" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>

            <!-- ─── Recordatorio de Tareas ─── -->
            <Frame BackgroundColor="#1E1E1E" BorderColor="#2C2C2C" CornerRadius="16" Padding="16" HasShadow="False">
                <VerticalStackLayout Spacing="16">

                    <!-- Cabecera de la tarjeta -->
                    <Grid ColumnDefinitions="Auto, *" VerticalOptions="Center">
                        <Frame Grid.Column="0" BackgroundColor="#2C2C2C" WidthRequest="40" HeightRequest="40" CornerRadius="12" Padding="0" HasShadow="False">
                            <Label Text="📝" FontSize="18" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Frame>
                        <VerticalStackLayout Grid.Column="1" Margin="12,0,0,0" Spacing="2" VerticalOptions="Center">
                            <Label Text="Recordatorio de tareas" TextColor="White" FontSize="17" FontAttributes="Bold" />
                            <Label Text="No olvides tus pendientes" TextColor="#8E8E93" FontSize="12" />
                        </VerticalStackLayout>
                    </Grid>

                    <!-- Recordatorio -->
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Recuérdame revisar mis tareas" TextColor="White" FontSize="14" />
                            <Label Text="Te avisará mientras tengas pendientes" TextColor="#8E8E93" FontSize="12" />
                        </VerticalStackLayout>
                        <Switch x:Name="SwTareas" Grid.Column="1" IsToggled="False" OnColor="Black" />
                    </Grid>

                    <!-- Frecuencia + Guardar -->
                    <Grid ColumnDefinitions="Auto, *, Auto" ColumnSpacing="10">
                        <Label Grid.Column="0" Text="Frecuencia (min)" TextColor="#8E8E93" FontSize="13" VerticalOptions="Center" />
                        <Entry x:Name="TxtFrecTareas" Grid.Column="1"
                               Keyboard="Numeric"
                               Placeholder="60"
                               TextColor="White"
                               PlaceholderColor="#555"
                               BackgroundColor="#2C2C2C"
                               HeightRequest="42"
                               FontSize="14"
                               HorizontalOptions="Fill" />
                        <Button Grid.Column="2" Text="Guardar"
                                BackgroundColor="White"
                                TextColor="Black"
                                BorderColor="#3A3A3A"
                                BorderWidth="1"
                                FontAttributes="Bold"
                                FontSize="13"
                                CornerRadius="10"
                                Padding="16,0"
                                HeightRequest="42"
                                VerticalOptions="Center"
                                Clicked="OnGuardarTareasClicked" />
                    </Grid>

                    <BoxView HeightRequest="1" BackgroundColor="#2C2C2C" />

                    <!-- Estado -->
                    <Grid ColumnDefinitions="Auto, *" ColumnSpacing="12">
                        <Frame Grid.Column="0" BackgroundColor="#2C2C2C" WidthRequest="52" HeightRequest="52" CornerRadius="26" Padding="0" HasShadow="False">
                            <Label Text="📝" FontSize="22" HorizontalOptions="Center" VerticalOptions="Center" />
                        </Frame>
                        <VerticalStackLayout Grid.Column="1" Spacing="6" VerticalOptions="Center">
                            <Label x:Name="LblEstadoTareas" Text="Activa el recordatorio para recibir avisos" TextColor="White" FontSize="14" FontAttributes="Bold" />
                            <Label Text="Se programa según la frecuencia que definas" TextColor="#8E8E93" FontSize="12" />
                        </VerticalStackLayout>
                    </Grid>
                </VerticalStackLayout>
            </Frame>

        </VerticalStackLayout>
    </ScrollView>

</ContentPage>