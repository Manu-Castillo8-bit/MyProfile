<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Proyecto.Salud"
             Title="Salud"

  
             BackgroundColor="#121212"
             Shell.NavBarIsVisible="False">

        <ScrollView>
            <VerticalStackLayout Padding="20,40,20,30" Spacing="20">

                <Label Text="Salud y Bienestar" FontSize="22" FontAttributes="Bold" TextColor="White" />

                <!-- Sección Hidratación -->
                <Frame BackgroundColor="#1E1E1E" BorderColor="#2C2C2C" CornerRadius="16" Padding="16" HasShadow="False">
                    <VerticalStackLayout Spacing="12">
                        <Label Text="💧 Hidratación" TextColor="White" FontSize="16" FontAttributes="Bold" />

                        <Grid ColumnDefinitions="Auto, *">
                            <Frame Grid.Column="0" BackgroundColor="#2C2C2C" WidthRequest="60" HeightRequest="70" CornerRadius="10" Padding="0" HasShadow="False">
                                <Label Text="🚰" FontSize="24" HorizontalOptions="Center" VerticalOptions="Center" />
                            </Frame>
                            <VerticalStackLayout Grid.Column="1" Margin="15,0,0,0" Spacing="4" VerticalOptions="Center">
                                <Label Text="Vasos hoy: 0 / 8" TextColor="White" FontSize="15" FontAttributes="Bold" />
                                <ProgressBar Progress="0.0" ProgressColor="White" BackgroundColor="#2C2C2C" HeightRequest="6" />
                                <Label Text="0% de la meta diaria" TextColor="#8E8E93" FontSize="11" />
                            </VerticalStackLayout>
                        </Grid>

                        <Button Text="+ Registrar vaso" BackgroundColor="White" TextColor="Black" FontAttributes="Bold" CornerRadius="12" HeightRequest="40" />
                    </VerticalStackLayout>
                </Frame>

                <!-- Sección Descanso Visual -->
                <Frame BackgroundColor="#1E1E1E" BorderColor="#2C2C2C" CornerRadius="16" Padding="16" HasShadow="False">
                    <VerticalStackLayout Spacing="14">
                        <Label Text="👁️ Descanso Visual" TextColor="White" FontSize="16" FontAttributes="Bold" />

                        <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                            <Label Grid.Column="0" Text="Activar recordatorio cada 20 min" TextColor="#8E8E93" FontSize="14" VerticalOptions="Center" />
                            <Switch Grid.Column="1" IsToggled="True" OnColor="White" />
                        </Grid>

                        <BoxView HeightRequest="1" BackgroundColor="#2C2C2C" />

                        <VerticalStackLayout Spacing="4">
                            <Label Text="Próximo descanso en N min" TextColor="White" FontSize="14" FontAttributes="Bold" />
                            <Label Text="Descansa la vista 5 minutos cada 20 minutos de uso." TextColor="#8E8E93" FontSize="12" />
                        </VerticalStackLayout>
                    </VerticalStackLayout>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>
    
</ContentPage>