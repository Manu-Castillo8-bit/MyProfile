<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Proyecto.Password"
             Title="Password"
             BackgroundColor="#121212"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto, Auto, *">
        <!-- Título y Botón Agregar -->
        <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Padding="20,20,20,10">
            <Label Grid.Column="0" Text="Mis Contraseñas" FontSize="22" FontAttributes="Bold" TextColor="White" VerticalOptions="Center" />
            <Button Grid.Column="1" Text="+" BackgroundColor="#1E1E1E" TextColor="White" FontAttributes="Bold" CornerRadius="10" WidthRequest="40" HeightRequest="40" />
        </Grid>

        <!-- Barra de Búsqueda -->
        <Frame Grid.Row="1" BackgroundColor="#1E1E1E" BorderColor="#2C2C2C" CornerRadius="12" Padding="12,5" Margin="20,0,20,15" HasShadow="False">
            <Entry Placeholder="Buscar credencial..." PlaceholderColor="#555555" TextColor="White" FontSize="14" />
        </Frame>

        <!-- Lista de Cuentas -->
        <ScrollView Grid.Row="2">
            <VerticalStackLayout Padding="20,0,20,20" Spacing="10">

                <!-- Credencial: Gmail -->
                <Frame BackgroundColor="#1E1E1E" BorderColor="#2C2C2C" CornerRadius="14" Padding="14" HasShadow="False">
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Gmail" TextColor="White" FontSize="15" FontAttributes="Bold" />
                            <Label Text="usuario.principal@gmail.com" TextColor="#8E8E93" FontSize="12" />
                            <Label Text="••••••••••••" TextColor="#555555" FontSize="12" />
                        </VerticalStackLayout>
                        <HorizontalStackLayout Grid.Column="1" Spacing="15" VerticalOptions="Center">
                            <Label Text="✏️" FontSize="16" />
                            <Label Text="🗑️" FontSize="16" />
                        </HorizontalStackLayout>
                    </Grid>
                </Frame>

                <!-- Credencial: Instagram -->
                <Frame BackgroundColor="#1E1E1E" BorderColor="#2C2C2C" CornerRadius="14" Padding="14" HasShadow="False">
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Instagram" TextColor="White" FontSize="15" FontAttributes="Bold" />
                            <Label Text="@usuario_oficial" TextColor="#8E8E93" FontSize="12" />
                            <Label Text="••••••••••••" TextColor="#555555" FontSize="12" />
                        </VerticalStackLayout>
                        <HorizontalStackLayout Grid.Column="1" Spacing="15" VerticalOptions="Center">
                            <Label Text="✏️" FontSize="16" />
                            <Label Text="🗑️" FontSize="16" />
                        </HorizontalStackLayout>
                    </Grid>
                </Frame>

                <!-- Credencial: Netflix -->
                <Frame BackgroundColor="#1E1E1E" BorderColor="#2C2C2C" CornerRadius="14" Padding="14" HasShadow="False">
                    <Grid ColumnDefinitions="*, Auto" VerticalOptions="Center">
                        <VerticalStackLayout Grid.Column="0" Spacing="2">
                            <Label Text="Netflix" TextColor="White" FontSize="15" FontAttributes="Bold" />
                            <Label Text="familia.netflix@gmail.com" TextColor="#8E8E93" FontSize="12" />
                            <Label Text="••••••••••••" TextColor="#555555" FontSize="12" />
                        </VerticalStackLayout>
                        <HorizontalStackLayout Grid.Column="1" Spacing="15" VerticalOptions="Center">
                            <Label Text="✏️" FontSize="16" />
                            <Label Text="🗑️" FontSize="16" />
                        </HorizontalStackLayout>
                    </Grid>
                </Frame>

            </VerticalStackLayout>
        </ScrollView>
    </Grid>
</ContentPage>

