<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Proyecto.Password"
             Title="Password"
             BackgroundColor="#121212"
             Shell.NavBarIsVisible="False">

    <Grid>
        <Grid RowDefinitions="Auto, Auto, *">

            <!-- Título y Botón Agregar -->
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Padding="20,20,20,10">
                <Label Grid.Column="0" Text="Mis Contraseñas" FontSize="22" FontAttributes="Bold" TextColor="White" VerticalOptions="Center" />
                <Button Grid.Column="1" x:Name="BtnAgregar" Text="+" BackgroundColor="#1E1E1E" TextColor="White" FontAttributes="Bold" CornerRadius="10" WidthRequest="40" HeightRequest="40" Clicked="OnAgregarClicked" />
            </Grid>

            <!-- Barra de Búsqueda -->
            <Frame Grid.Row="1" BackgroundColor="#1E1E1E" BorderColor="#2C2C2C" CornerRadius="12" Padding="12,5" Margin="20,0,20,15" HasShadow="False">
                <Entry x:Name="TxtBuscar" Placeholder="Buscar credencial..." PlaceholderColor="#555555" TextColor="White" FontSize="14" TextChanged="OnBuscarChanged" />
            </Frame>

            <!-- Lista de Cuentas -->
            <ScrollView Grid.Row="2">
                <VerticalStackLayout x:Name="ListaCuentas" Padding="20,0,20,20" Spacing="10" />
            </ScrollView>
        </Grid>

        <!-- Modal de formulario (superpuesto) -->
        <Grid x:Name="FormOverlay" IsVisible="False" BackgroundColor="#80000000">
            <Frame BackgroundColor="#1E1E1E" BorderColor="#2C2C2C" CornerRadius="20"
                   Padding="24" WidthRequest="340"
                   VerticalOptions="Center" HorizontalOptions="Center" HasShadow="True">
                <VerticalStackLayout Spacing="14">
                    <Label x:Name="LblFormTitulo" Text="Nueva credencial" TextColor="White" FontSize="18" FontAttributes="Bold" />

                    <Label Text="Sitio web" TextColor="#8E8E93" FontSize="12" />
                    <Entry x:Name="TxtSitioWeb" Placeholder="Ej: Gmail, Netflix..." TextColor="White" PlaceholderColor="#555" BackgroundColor="#2C2C2C" HeightRequest="42" />

                    <Label Text="Usuario / Cuenta" TextColor="#8E8E93" FontSize="12" />
                    <Entry x:Name="TxtUsuarioCuenta" Placeholder="usuario@email.com" TextColor="White" PlaceholderColor="#555" BackgroundColor="#2C2C2C" HeightRequest="42" />

                    <Label x:Name="LblClave" Text="Clave" TextColor="#8E8E93" FontSize="12" />
                    <Entry x:Name="TxtClave" Placeholder="••••••••" IsPassword="True" TextColor="White" PlaceholderColor="#555" BackgroundColor="#2C2C2C" HeightRequest="42" />

                    <Grid ColumnDefinitions="*, *" ColumnSpacing="10" Margin="0,8,0,0">
                        <Button Grid.Column="0" Text="Cancelar" BackgroundColor="#2C2C2C" TextColor="White" CornerRadius="10" HeightRequest="44" Clicked="OnCancelarClicked" />
                        <Button Grid.Column="1" x:Name="BtnGuardar" Text="Guardar" BackgroundColor="White" TextColor="Black" FontAttributes="Bold" CornerRadius="10" HeightRequest="44" Clicked="OnGuardarClicked" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>
        </Grid>
    </Grid>

</ContentPage>
