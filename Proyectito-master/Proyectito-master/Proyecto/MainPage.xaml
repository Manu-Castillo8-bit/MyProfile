<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="Proyecto.MainPage"
    BackgroundColor="#121212"
             Shell.NavBarIsVisible="False">

    <Grid>
        <Grid RowDefinitions="Auto, Auto, *">
            <!-- Título y Botón Agregar -->
            <Grid Grid.Row="0" ColumnDefinitions="*, Auto" Padding="20,20,20,10">
                <VerticalStackLayout Grid.Column="0" Spacing="2">
                    <Label Text="Mis Tareas" FontSize="22" FontAttributes="Bold" TextColor="White" VerticalOptions="Center" />
                    <Label x:Name="LblDepuracion" Text="Depuración: esperando..." FontSize="11" TextColor="#FFD700" />
                </VerticalStackLayout>
                <Button Grid.Column="1" x:Name="BtnAgregar" Text="+" BackgroundColor="#1E1E1E" TextColor="White" FontAttributes="Bold" CornerRadius="10" WidthRequest="40" HeightRequest="40" Clicked="OnAgregarClicked" />
            </Grid>

            <!-- Selector de Pestañas (Pendientes / Completadas) -->
            <Grid Grid.Row="1" ColumnDefinitions="*, *" Padding="20,0,20,15" ColumnSpacing="10">
                <Button Grid.Column="0" x:Name="BtnPendientes" Text="Pendientes" BackgroundColor="White" TextColor="Black" FontAttributes="Bold" CornerRadius="12" HeightRequest="40" Clicked="OnPendientesClicked" />
                <Button Grid.Column="1" x:Name="BtnCompletadas" Text="Completadas" BackgroundColor="#1E1E1E" TextColor="#8E8E93" CornerRadius="12" HeightRequest="40" Clicked="OnCompletadasClicked" />
            </Grid>

            <!-- Lista de Tareas -->
            <ScrollView Grid.Row="2">
                <VerticalStackLayout x:Name="ListaTareas" Padding="20,0,20,20" Spacing="10">

                </VerticalStackLayout>
            </ScrollView>
        </Grid>

        <!-- Modal de formulario de tarea (superpuesto) -->
        <Grid x:Name="FormOverlay" IsVisible="False" BackgroundColor="#80000000">
            <Frame BackgroundColor="#1E1E1E" BorderColor="#2C2C2C" CornerRadius="20"
                   Padding="24" WidthRequest="340"
                   VerticalOptions="Center" HorizontalOptions="Center" HasShadow="True">
                <VerticalStackLayout Spacing="14">
                    <Label x:Name="LblFormTitulo" Text="Nueva tarea" TextColor="White" FontSize="18" FontAttributes="Bold" />

                    <Label Text="Título" TextColor="#8E8E93" FontSize="12" />
                    <Entry x:Name="TxtTitulo" Placeholder="Ej: Comprar víveres..." TextColor="White" PlaceholderColor="#555" BackgroundColor="#2C2C2C" HeightRequest="42" />

                    <Label Text="Descripción" TextColor="#8E8E93" FontSize="12" />
                    <Editor x:Name="TxtDescripcion" Placeholder="Detalles de la tarea..." TextColor="White" PlaceholderColor="#555" BackgroundColor="#2C2C2C" HeightRequest="80" />

                    <Label Text="Fecha de vencimiento" TextColor="#8E8E93" FontSize="12" />
                    <DatePicker x:Name="FchVencimiento" TextColor="White" BackgroundColor="#2C2C2C" />

                    <Grid ColumnDefinitions="*,*,*" ColumnSpacing="10" Margin="0,8,0,0">
                        <Button Grid.Column="0" Text="Cancelar" BackgroundColor="#2C2C2C" TextColor="White" CornerRadius="10" HeightRequest="44" Clicked="OnCancelarClicked" />
                        <Button Grid.Column="1" Text="Guardar" BackgroundColor="White" TextColor="Black" FontAttributes="Bold" CornerRadius="10" HeightRequest="44" Clicked="OnGuardarClicked" />
                    </Grid>
                </VerticalStackLayout>
            </Frame>
        </Grid>
    </Grid>

</ContentPage>
