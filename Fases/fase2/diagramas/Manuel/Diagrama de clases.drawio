        <UserObject label="" mermaidData="{&#xa;  &quot;data&quot;: &quot;classDiagram\n  class Usuario {\n    +String id_usuario\n    +String nombre\n    +String correo\n    +String clave\n    +iniciarSesion()\n    +cerrarSesion()\n  }\n\n  class Tarea {\n    +String id_tarea\n    +String titulo\n    +String descripcion\n    +Date fecha_vencimiento\n    +String estado\n    +crear()\n    +cambiarEstado()\n    +eliminar()\n  }\n\n  class TransaccionFinanciera {\n    +String id_transaccion\n    +String tipo\n    +Decimal monto\n    +String descripcion\n    +Date fecha\n    +registrar()\n    +calcularSaldo()\n  }\n\n  class Credencial {\n    +String id_credencial\n    +String plataforma\n    +String usuario_cuenta\n    +String clave_cifrada\n    +guardar()\n    +editar()\n    +eliminar()\n  }\n\n  class RecordatorioSalud {\n    +String id_recordatorio\n    +String tipo\n    +int intervalo_minutos\n    +Boolean estado_activo\n    +activar()\n    +programarAlerta()\n  }\n\n  class Notificacion {\n    +String id_notificacion\n    +String mensaje\n    +String medio\n    +Date fecha_envio\n    +enviarAlerta()\n  }\n\n  class Administrador {\n    +String nivel_acceso\n    +monitorearSistema()\n    +gestionarCuentaUsuario()\n  }\n\n  Usuario &lt;|-- Administrador\n  Usuario \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Tarea : gestiona\n  Usuario \&quot;1\&quot; --&gt; \&quot;0..*\&quot; TransaccionFinanciera : registra\n  Usuario \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Credencial : administra\n  Usuario \&quot;1\&quot; --&gt; \&quot;0..*\&quot; RecordatorioSalud : configura\n  Notificacion \&quot;0..*\&quot; --&gt; \&quot;1\&quot; Usuario : informa\n  RecordatorioSalud \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Notificacion : genera\n  Administrador \&quot;1\&quot; --&gt; \&quot;0..*\&quot; Usuario : gestiona cuentas&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="3Hn_yNURMOWdXFMVmh3a-1">
